{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server/prisma-api.mjs",
    "api:prisma": "node server/prisma-api.mjs",
    "api:demo": "node server/index.mjs",
    "dev:full": "concurrently -k \"npm run api:demo\" \"npm run dev\"",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "test:api": "node server/test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@tanstack/react-query": "^5.59.0",
    "lucide-react": "^1.45.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.1.2",
    "oxfmt": "^0.2.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
