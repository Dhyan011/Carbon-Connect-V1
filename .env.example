NODE_ENV=development
PORT=4000
# API_PORT is retained for Docker/local compatibility; PORT takes precedence.
API_PORT=4000
DATABASE_URL=postgresql://carbon:carbon_dev_password@localhost:5432/carbon_connect
REDIS_URL=redis://localhost:6379
VITE_API_BASE_URL=http://localhost:4000
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=carbon-connect-documents
S3_ACCESS_KEY=carbon
S3_SECRET_KEY=carbon_dev_password
EMAIL_PROVIDER=console
PAYMENT_PROVIDER=demo
